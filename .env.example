# Root-level environment variables for Docker Compose orchestration.
# Copy to .env and fill in values before running any `docker compose` command.
#
# App/service-specific config lives in:
#   server/.env.*        — FastAPI config (DB, Clerk, LLM, rate limits, …)
#   web-app/apps/web/.env.local   — Next.js config (NEXT_PUBLIC_* build args, Clerk keys, …)

# Controls which server env file docker-compose.dev.yml loads
# (./server/.env.${APP_ENV:-development})
APP_ENV=development

# Tags Docker image names and Traefik router/service names (see docker-compose.prod.yml)
COMPOSE_PROJECT_NAME=b2c-template

# Grafana admin password — required by docker-compose.dev.yml (monitoring stack)
GRAFANA_ADMIN_PASSWORD=change-me

# Host port docker-compose.dev.yml publishes the web app on
WEB_HOST_PORT=3000

# Public hostname for the web app, used by docker-compose.prod.yml's Traefik labels
WEB_DOMAIN=app.example.com

# Public hostname for the API, used by docker-compose.prod.yml's Traefik labels
API_DOMAIN=api.example.com

# Clerk application id, written by `make clerk-bootstrap-env` and read by every
# other clerk-* target (the Makefile's `-include .env` is what exposes it)
CLERK_APP_ID=

# ngrok static domain and authtoken for local Clerk webhook delivery
# (see docs/setup/clerk-webhooks.md)
NGROK_DOMAIN=xx
NGROK_AUTHTOKEN=xx
