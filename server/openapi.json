{
  "components": {
    "schemas": {
      "AgentStatus": {
        "description": "Readiness of a single agent.",
        "properties": {
          "graph_compiled": {
            "description": "LangGraph graph is compiled",
            "title": "Graph Compiled",
            "type": "boolean"
          },
          "ready": {
            "description": "Agent reports itself ready",
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "graph_compiled"
        ],
        "title": "AgentStatus",
        "type": "object"
      },
      "Body_renameConversation": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "Body_renameConversation",
        "type": "object"
      },
      "ChatRequest": {
        "description": "Request model for chat endpoint.\n\nAttributes:\n    message: The user's message to send.",
        "properties": {
          "message": {
            "description": "The user's message content",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "description": "Response model for chat endpoint.\n\nAttributes:\n    message: The assistant's response message.",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message",
            "description": "The assistant's response message"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "ComponentsStatus": {
        "description": "Per-component readiness detail.\n\n`agents` is always a mapping of agent name to status \u2014 never a bare string,\nand never wrapped in an envelope. The \"agents were never initialised\"\ncondition is carried by `agents_error`, so the value's shape does not\ndepend on the outcome.",
        "properties": {
          "agents": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AgentStatus"
            },
            "description": "Agent name to readiness status",
            "title": "Agents",
            "type": "object"
          },
          "agents_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the agent registry was never initialised",
            "title": "Agents Error"
          },
          "agents_healthy": {
            "description": "Every registered agent is ready",
            "title": "Agents Healthy",
            "type": "boolean"
          },
          "api": {
            "const": "healthy",
            "description": "The API itself is serving",
            "title": "Api",
            "type": "string"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus",
            "description": "Database component"
          }
        },
        "required": [
          "api",
          "database",
          "agents_healthy"
        ],
        "title": "ComponentsStatus",
        "type": "object"
      },
      "ConnectionPoolStats": {
        "description": "SQLAlchemy connection pool counters.",
        "properties": {
          "checked_in": {
            "description": "Connections idle in the pool",
            "title": "Checked In",
            "type": "integer"
          },
          "checked_out": {
            "description": "Connections currently in use",
            "title": "Checked Out",
            "type": "integer"
          },
          "overflow": {
            "description": "Connections created beyond the pool size",
            "title": "Overflow",
            "type": "integer"
          },
          "size": {
            "description": "Configured pool size",
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "description": "size + overflow",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "size",
          "checked_in",
          "checked_out",
          "overflow",
          "total"
        ],
        "title": "ConnectionPoolStats",
        "type": "object"
      },
      "ConversationHistory": {
        "description": "Response model for conversation history endpoint.\n\nAttributes:\n    messages: List of all messages in the conversation.",
        "properties": {
          "messages": {
            "description": "List of all messages in the conversation",
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "title": "ConversationHistory",
        "type": "object"
      },
      "ConversationResponse": {
        "description": "Response model for conversation operations.\n\nAttributes:\n    conversation_id: The unique identifier for the chat conversation\n    name: Name of the conversation (defaults to empty string)\n    created_at: When the conversation was created",
        "properties": {
          "conversation_id": {
            "description": "The unique identifier for the chat conversation",
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "description": "When the conversation was created",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "name": {
            "default": "",
            "description": "Name of the conversation",
            "maxLength": 100,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "conversation_id",
          "created_at"
        ],
        "title": "ConversationResponse",
        "type": "object"
      },
      "DatabaseStatus": {
        "description": "Database connectivity and pool state.",
        "properties": {
          "connection_pool": {
            "$ref": "#/components/schemas/ConnectionPoolStats",
            "description": "Pool counters"
          },
          "status": {
            "description": "Database reachability",
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "connection_pool"
        ],
        "title": "DatabaseStatus",
        "type": "object"
      },
      "Environment": {
        "description": "Application environment types.\n\nDefines the possible environments the application can run in:\ndevelopment, staging, production, and test.",
        "enum": [
          "development",
          "staging",
          "production",
          "test"
        ],
        "title": "Environment",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Minimal public health check returned by GET /health.",
        "properties": {
          "status": {
            "description": "Overall health",
            "enum": [
              "healthy",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "description": "When the check ran",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Message": {
        "description": "Message model for chat endpoint.\n\nAttributes:\n    role: The role of the message sender (user or assistant).\n    content: The content of the message.",
        "properties": {
          "content": {
            "description": "The content of the message",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "description": "The role of the message sender",
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "Message",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Detailed authenticated readiness returned by GET /ready.",
        "properties": {
          "components": {
            "$ref": "#/components/schemas/ComponentsStatus",
            "description": "Per-component detail"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment",
            "description": "Deployment environment"
          },
          "status": {
            "description": "Overall readiness",
            "enum": [
              "healthy",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "description": "When the check ran",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "description": "Application version",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "environment",
          "components",
          "timestamp"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RootResponse": {
        "description": "Basic API metadata returned by GET /.",
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/Environment",
            "description": "Deployment environment"
          },
          "name": {
            "description": "Project name",
            "title": "Name",
            "type": "string"
          },
          "redoc_url": {
            "description": "Path to the ReDoc UI",
            "title": "Redoc Url",
            "type": "string"
          },
          "status": {
            "const": "healthy",
            "description": "Always healthy if this responds",
            "title": "Status",
            "type": "string"
          },
          "swagger_url": {
            "description": "Path to the Swagger UI",
            "title": "Swagger Url",
            "type": "string"
          },
          "version": {
            "description": "Application version",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "status",
          "environment",
          "swagger_url",
          "redoc_url"
        ],
        "title": "RootResponse",
        "type": "object"
      },
      "UserResponse": {
        "description": "Response model for user profile.\n\nAttributes:\n    id: Internal user ID (UUID string)\n    clerk_id: External Clerk user ID\n    email: User's email address\n    first_name: User's first name\n    last_name: User's last name\n    avatar_url: User's avatar URL\n    created_at: When the user was created",
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User's avatar URL",
            "title": "Avatar Url"
          },
          "clerk_id": {
            "description": "Clerk user ID",
            "title": "Clerk Id",
            "type": "string"
          },
          "created_at": {
            "description": "Account creation timestamp",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "description": "User's email address",
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User's first name",
            "title": "First Name"
          },
          "id": {
            "description": "Internal user ID (UUID)",
            "title": "Id",
            "type": "string"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User's last name",
            "title": "Last Name"
          }
        },
        "required": [
          "id",
          "clerk_id",
          "email",
          "created_at"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OAuth2AuthorizationCodeBearer": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "",
            "scopes": {
              "email": "Email address",
              "offline_access": "Refresh token",
              "openid": "OpenID Connect",
              "profile": "Profile information"
            },
            "tokenUrl": ""
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "A production-ready FastAPI service with LangGraph and Clerk authentication, for consumer applications.",
    "title": "B2C Template - Server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Retrieve basic API metadata including version, environment, and documentation URLs.",
        "operationId": "getRoot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get API information",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/admin/ping": {
      "get": {
        "description": "Returns 200 for a caller whose role is `admin`, 403 otherwise. Exists to verify the role claim, the middleware and require_role() end to end.",
        "operationId": "adminPing",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Adminping",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Admin-only smoke endpoint",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/auth/me": {
      "delete": {
        "description": "Permanently delete the authenticated user's account and all associated data. This action cannot be undone.",
        "operationId": "deleteMe",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Delete current user account (GDPR)",
        "tags": [
          "auth"
        ]
      },
      "get": {
        "description": "Retrieve the authenticated user's profile information. Creates the user in the database on first access (JIT provisioning).",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Get current user profile",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/chatbot/chat/{conversation_id}": {
      "post": {
        "description": "Process a chat message and return the AI agent's response.",
        "operationId": "sendChatMessage",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Send a message and get a response",
        "tags": [
          "chatbot"
        ]
      }
    },
    "/api/v1/chatbot/chat/{conversation_id}/messages": {
      "delete": {
        "description": "Remove all messages from the specified chat conversation.",
        "operationId": "clearChatHistory",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Clear chat history",
        "tags": [
          "chatbot"
        ]
      },
      "get": {
        "description": "Retrieve all messages from the specified chat conversation.",
        "operationId": "listChatMessages",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationHistory"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Get conversation chat history",
        "tags": [
          "chatbot"
        ]
      }
    },
    "/api/v1/chatbot/chat/{conversation_id}/stream": {
      "post": {
        "description": "Send a message and receive the AI agent's response as a server-sent event stream.",
        "operationId": "streamChatMessage",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Stream chat response in real-time",
        "tags": [
          "chatbot",
          "streaming"
        ]
      }
    },
    "/api/v1/conversation/conversation": {
      "post": {
        "description": "Initialize a new chat conversation for the authenticated user with a unique conversation ID.",
        "operationId": "createConversation",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Create a new chat conversation",
        "tags": [
          "conversation"
        ]
      }
    },
    "/api/v1/conversation/conversation/{conversation_id}": {
      "delete": {
        "description": "Remove a chat conversation and permanently delete all associated messages.",
        "operationId": "deleteConversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Delete a chat conversation",
        "tags": [
          "conversation"
        ]
      }
    },
    "/api/v1/conversation/conversation/{conversation_id}/name": {
      "patch": {
        "description": "Update the display name of an existing chat conversation.",
        "operationId": "renameConversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_renameConversation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "Rename a chat conversation",
        "tags": [
          "conversation"
        ]
      }
    },
    "/api/v1/conversation/conversations": {
      "get": {
        "description": "Retrieve all chat conversations created by the authenticated user.",
        "operationId": "listConversations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationResponse"
                  },
                  "title": "Response Listconversations",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ],
        "summary": "List all user chat conversations",
        "tags": [
          "conversation"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Minimal public health check endpoint for container orchestration and load balancers. Returns basic status without sensitive details.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "System is degraded"
          }
