{
  "name": "@app/api-client",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./endpoints/*": "./src/generated/endpoints/*/index.ts",
    "./types": "./src/generated/types/index.ts",
    "./zod/*": "./src/generated/zod/*/index.ts"
  },
  "scripts": {
    "gen:api": "orval && node scripts/postgen.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@app/auth": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "orval": "8.27.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  }
}
